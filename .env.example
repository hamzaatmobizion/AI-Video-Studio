# ---------------- Web app ----------------
# Random, ≥32 chars (./run.sh setup fills this in)
SECRET_KEY=
DATABASE_URL=sqlite:///./var/app.db
# true when served over HTTPS (production)
COOKIE_SECURE=false
# Where the worker listens, and its key (must equal STUDIO_API_KEY)
WORKER_URL=http://127.0.0.1:8100
WORKER_API_KEY=
# Google OAuth "Web application" client; redirect URI = PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_NAME=VideoGeneration
PUBLIC_BASE_URL=http://localhost:8000
# Web app port used by ./run.sh (keep PUBLIC_BASE_URL in step)
APP_PORT=8000
# Fernet key for stored tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
VAR_DIR=./var
SCHEDULER_ENABLED=true

# ---------------- Worker ----------------
STUDIO_DATA_PATH=./data
# Defaults to $STUDIO_DATA_PATH/browser-profile. It is a credential: never copy or back it up.
BROWSER_PROFILE_PATH=
# Loopback only; the worker refuses anything else
API_HOST=127.0.0.1
API_PORT=8100
# ≥24 random chars (./run.sh setup fills this in)
STUDIO_API_KEY=
# Model to pick in Gemini's model picker. Leave unset to use profile.json (null = whatever is selected).
# GEMINI_MODEL_LABEL=
GENERATION_TIMEOUT_SECONDS=900
# Extra attempts after a failed clip (QC or Gemini error). Never applies to limits/sign-out/safety.
MAX_RETRIES=1
BROWSER_HEADLESS=false
# Empty = Playwright's Chromium; "chrome" = installed Google Chrome
BROWSER_CHANNEL=
