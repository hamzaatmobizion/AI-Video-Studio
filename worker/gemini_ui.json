{
  "_note": "All Gemini UI knowledge lives here. When Gemini changes its page, edit this file (run `python -m worker check-gemini` to see what matches). Each selector key is a list of candidates; the first visible match wins.",
  "app_url": "https://gemini.google.com/app",
  "allowed_hosts": [
    "gemini.google.com",
    "accounts.google.com",
    "consent.google.com",
    "www.google.com"
  ],
  "selectors": {
    "prompt_input": [
      "rich-textarea div[contenteditable='true']",
      "div.ql-editor[contenteditable='true']",
      "[role='textbox'][contenteditable='true']"
    ],
    "send_button": [
      "button[aria-label='Send message']",
      "button[aria-label*='Send' i]",
      "button.send-button"
    ],
    "sign_in_button": [
      "a[href*='accounts.google.com/ServiceLogin']",
      "a[aria-label='Sign in']",
      "a:has-text('Sign in')",
      "button:has-text('Sign in')"
    ],
    "account_button": [
      "a[aria-label*='Google Account' i]",
      "a[href*='accounts.google.com/SignOutOptions']",
      "img.gb_P[alt]"
    ],
    "tools_button": [
      "button[aria-label='Upload & tools']",
      "button[aria-label='Tools']",
      "toolbox-drawer button",
      "button:has-text('Tools')"
    ],
    "more_tools": [
      "button[aria-label='More tools']",
      "button:has-text('More tools')",
      "button:has-text('More')"
    ],
    "upgrade_button": [
      "gem-button button:has-text('Upgrade')",
      "button:has-text('Upgrade')",
      "a:has-text('Upgrade')"
    ],
    "video_tool": [
      "button:has-text('Create videos')",
      "button:has-text('Create video')",
      "[role='menuitemcheckbox']:has-text('Create video')",
      "[role='menuitemcheckbox']:has-text('Video')",
      "toolbox-drawer-item button:has-text('Video')"
    ],
    "video_tool_active": [
      "button[aria-label*='Deselect Video' i]",
      "button[aria-label*='Video' i][aria-pressed='true']",
      ".toolbox-drawer-item-deselect-button:has-text('Video')"
    ],
    "model_switch": [
      "button[data-test-id='bard-mode-menu-button']",
      "bard-mode-switcher button",
      "button[aria-label*='mode picker' i]"
    ],
    "model_option": [
      "[role='menuitemradio']:has-text('{label}')",
      "[role='menuitem']:has-text('{label}')",
      "button.bard-mode-list-button:has-text('{label}')"
    ],
    "aspect_switch": [
      "button[aria-label*='aspect ratio' i]",
      "button:has-text('Landscape')",
      "button:has-text('Portrait')"
    ],
    "aspect_option": [
      "[role='menuitemradio']:has-text('{label}')",
      "[role='menuitem']:has-text('{label}')",
      "[role='option']:has-text('{label}')",
      "button:has-text('{label}')"
    ],
    "file_input": [
      "input[type='file']"
    ],
    "upload_button": [
      "button[aria-label*='upload file menu' i]",
      "button[aria-label*='Add files' i]",
      "button[aria-label*='Upload' i]"
    ],
    "upload_menu_item": [
      "[role='menuitem']:has-text('Upload files')",
      "button:has-text('Upload files')"
    ],
    "rights_reminder_agree": [
      "[role='dialog']:has-text('reminder about creating videos') button:has-text('Agree')",
      "mat-dialog-container:has-text('rights to any content you upload') button:has-text('Agree')"
    ],
    "upload_consent_agree": [
      "[role='dialog']:has-text('Creating content from images and files') button:has-text('Agree')",
      "mat-dialog-container:has-text('Creating content from images') button:has-text('Agree')"
    ],
    "attachment_preview": [
      "uploader-file-preview",
      "[data-test-id='file-preview']",
      ".file-preview-container img"
    ],
    "response": [
      "model-response"
    ],
    "reply_busy": [
      "button[aria-label*='Stop response' i]",
      "button[aria-label='Stop']",
      "button:has-text('Answer now')"
    ],
    "response_video": [
      "video"
    ],
    "response_image": [
      "generated-image img",
      "single-image img",
      "model-response img[src*='googleusercontent']",
      "model-response img[src^='blob:']"
    ],
    "download_button": [
      "button[aria-label*='Download' i]"
    ],
    "image_download_button": [
      "button[aria-label='Download full size image']",
      "button[aria-label*='Download' i]"
    ],
    "captcha": [
      "iframe[src*='recaptcha']",
      "iframe[title*='reCAPTCHA' i]"
    ]
  },
  "ab_survey": {
    "_note": "Gemini sometimes shows two answers side by side to vote on; the worker reads the first, never votes.",
    "marker": "Which response is more helpful",
    "first": "Choice A",
    "second": "Choice B"
  },
  "patterns": {
    "plan_misroute": [
      "(i'?m|i am) (generating|creating|making) (your|the|a) video",
      "your video (is ready|will be ready)",
      "check back to see when your video"
    ],
    "image_limit": [
      "create more images",
      "image (generation )?limit",
      "(generate|create|make) (more )?images? (when|once|as soon as)"
    ],
    "verification": [
      "unusual traffic",
      "verify (it'?s|that it'?s) you",
      "i'?m not a robot",
      "captcha",
      "confirm (it'?s|that it'?s) you"
    ],
    "limit": [
      "reached (your|the) (daily |video )?(generation )?limit",
      "limit (resets|will reset)",
      "you'?ve hit (your|the) limit",
      "(no|out of) (more )?video generations",
      "come back (later|tomorrow) (to|for) (create|make|generate) (more )?videos?"
    ],
    "no_subscription": [
      "upgrade to (google )?ai (pro|ultra|plus)",
      "available (with|on|in) (google )?ai (pro|ultra|plus)",
      "subscribe to (google )?(ai|gemini)",
      "requires a (google )?ai (pro|ultra|plus)"
    ],
    "real_people": [
      "(can'?t|cannot|won'?t|unable to) (make|create|generate) (videos?|clips?|content) (of|with|featuring) real (people|persons|individuals)",
      "videos? of real (people|persons|individuals)"
    ],
    "safety": [
      "(can'?t|cannot|won'?t|unable to) (create|generate|make) (that|this|a video|videos) (because|as it|since)",
      "(can'?t|cannot|won'?t|unable to) (create|generate|make) (videos?|clips?|content|images?) (that|which) (seem to |appear to |might )?(show|depict|involve|include|contain)",
      "(minors|children|a child|kids) in (dangerous|compromising|unsafe|sexual|inappropriate)",
      "(violat|goes against)\\w* (our|the) (policy|policies|guidelines)",
      "safety (policy|policies|guidelines|filters)"
    ],
    "busy": [
      "unusually high traffic",
      "at full capacity",
      "(too many|high number of) requests right now",
      "please try again later"
    ],
    "error": [
      "something went wrong",
      "(couldn'?t|could not|wasn'?t able to) (generate|create|make) (the|your) video",
      "an error occurred",
      "encounter(ed|ing) an error",
      "having a hard time fulfilling",
      "can i (try|help you with) something else"
    ],
    "signed_out": [
      "sign in to (continue|use gemini|gemini)",
      "^\\s*sign in\\s*$"
    ]
  }
}
